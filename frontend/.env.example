# EmailJS Configuration (for Contact Form)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Backend API URL (required for production, leave empty for local dev with Vite proxy)
# In production (Vercel), set this to your backend URL e.g. https://bloom-skin-backend.onrender.com
# VITE_API_URL=https://bloom-skin-backend.onrender.com
