# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Configuration
MONGO_URI=your_mongodb_connection_string

# Session & Security
SESSION_SECRET=your_random_session_secret_min_32_chars

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Cloudinary Configuration (Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (Resend — HTTP API, works on Render free tier)
# SMTP is blocked on Render free tier, so we use Resend's HTTP API.
# Sign up at https://resend.com and get an API key.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Bloom Skin <onboarding@resend.dev>

# ML Service URL (optional — defaults to http://127.0.0.1:5000)
# ML_API_URL=http://127.0.0.1:5000
